# Keep deployer credentials in a local ignored .env file; do not commit real keys.
PRIVATE_KEY=

# Robinhood Chain public RPCs (production deployments should use a provider URL with suitable limits).
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Replace with verified addresses for the selected network.
USDC_ADDRESS=0x0000000000000000000000000000000000000000
KEEPER_ADDRESS=0x0000000000000000000000000000000000000000
