# Non-production prototype. No live credentials are included or requested.
ARCUS_ENV=testnet
ARCUS_BASE_URL=https://api.testnet.arcus.xyz
ARCUS_ENABLE_TESTNET_SUBMISSION=false
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
ARCUS_API_KEY=
# Leave empty. The prototype accepts an Ed25519 KeyObject via code and does not
# assume an undocumented serialization for Arcus's one-time API Signing Key.
ARCUS_API_SIGNING_KEY=
